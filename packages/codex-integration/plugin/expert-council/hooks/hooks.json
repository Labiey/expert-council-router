{
  "description": "Record the current Codex session workspace immediately before an Expert Council MCP call.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__expert_council__expert_",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/record-workspace.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\record-workspace.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
