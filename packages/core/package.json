{
  "name": "@expert-council/core",
  "version": "0.5.4",
  "description": "Host-independent routing, policy, roles, escalation, and telemetry for Expert Council",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
