{
  "billing": {
    "providers": {
      "economy-api": {
        "billingType": "metered",
        "costMultiplier": 1.0
      },
      "premium-api": {
        "billingType": "metered",
        "costMultiplier": 5.0
      }
    }
  },
  "security": {
    "workspaceProvisioning": {
      "mode": "auto",
      "timeoutMs": 600000,
      "maxConcurrent": 1,
      "scrubEnv": true,
      "removalTimeoutMs": 300000
    }
  },
  "retry": {
    "maxAttempts": 3,
    "maxEscalations": 1
  }
}
